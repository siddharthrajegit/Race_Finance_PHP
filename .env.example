# ==============================================================================
# RACE FINANCE - Application Environment Configuration (PHP Edition)
# ==============================================================================

# Application Environment (production / development)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
SESSION_SECRET=change_this_to_a_random_64_character_hex_secret

# ------------------------------------------------------------------------------
# Database Settings (cPanel MySQL / MariaDB)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_biller
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=your_strong_mysql_password_here

# Note: If DB_CONNECTION=sqlite or DB_DATABASE is left blank, the app will
# automatically use SQLite stored in data/biller.db.

# ------------------------------------------------------------------------------
# Google OAuth 2.0 & Google Drive Backup (Optional)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://yourdomain.com/auth/google/callback
