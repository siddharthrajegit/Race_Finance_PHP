# Environment & Secrets (Never commit production credentials)
.env
.env.local
.env.*
!.env.example

# SQLite Database Files
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# User Uploads (Logos & Signatures)
public/uploads/*
!public/uploads/.gitkeep

# Backups & Archives
backups/
*.zip
*.tar.gz
*.sql.gz
*.bak

# Temporary & Log Files
logs/
*.log
cookies.txt
scratch/
tmp/
temp/

# Operating System & IDE Files
.DS_Store
Thumbs.db
[Dd]esktop.ini
.vscode/
.idea/
*.swp
*.swo

# Dependencies
vendor/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Stray files
watermarked_img_*
